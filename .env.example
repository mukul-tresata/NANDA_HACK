# Copy to .env and adjust. All values have safe defaults; nothing here is required
# to run the offline CLI/tests (the deterministic stub covers a missing server).

# --- LLM backend: self-hosted vLLM / OpenAI-compatible server -----------------
CEO_LLM_URL=http://localhost:8000/v1
CEO_LLM_MODEL=Qwen/Qwen3.6-35B-A3B
# Service-side override for the same base URL (optional; used by service/app.py):
# CEO_DELTA_LLM_BASE_URL=

# --- Grounding: none | web_search | nanda -------------------------------------
CEO_DELTA_GROUNDING_BACKEND=none
# Only read when CEO_DELTA_GROUNDING_BACKEND=web_search (Claude server-side tool):
ANTHROPIC_API_KEY=

# --- Persistence & service bind -----------------------------------------------
CEO_DELTA_WORKDIR=.ceo_delta
HOST=0.0.0.0
PORT=6001
